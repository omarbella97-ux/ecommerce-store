# Neon Postgres connection string (Neon dashboard -> Connect)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth
# Generate a secret with: openssl rand -base64 32 (at least 32 chars)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Stripe (test mode for development). Prefer a restricted key (rk_…) with
# Checkout Sessions write access. Never commit real keys.
STRIPE_SECRET_KEY=""
# From `stripe listen --print-secret` locally, or the endpoint's signing
# secret in the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET=""
# Public origin used for Checkout's success and cancel URLs.
APP_URL="http://localhost:3000"
